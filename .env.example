# OmniRoute API Configuration
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Server Configuration
PORT=8080
UPSTREAM_TIMEOUT_MS=60000

# Database (optional - default: bandit.db)
DATABASE_PATH=bandit.db

# Dashboard / Control API auth (opzionale ma fortemente consigliato)
# Se valorizzato, tutte le API di controllo richiedono questo token.
# Esempio di utilizzo: http://127.0.0.1:8080/dashboard?token=IL_TUO_TOKEN
DASHBOARD_TOKEN=YourSecureTokenHere