# OmniRoute API Configuration
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Server Configuration
PORT=8080
UPSTREAM_TIMEOUT_MS=60000

# Database (optional - default: bandit.db)
DATABASE_PATH=bandit.db

# Dashboard / Control API auth (opzionale ma fortemente consigliato)
# Se valorizzato, tutte le API di controllo richiedono questo token.
# Esempio di utilizzo: http://127.0.0.1:8080/dashboard?token=IL_TUO_TOKEN
DASHBOARD_TOKEN=YourSecureTokenHere
# Health check attivo (riabilita modelli bannati/cooldown se tornano raggiungibili)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=300000
HEALTH_CHECK_PROVIDER_INTERVALS_MS=
# Intervalli di health check per provider (formato: provider1=interval1,provider2=interval2)
# Esempio: HEALTH_CHECK_PROVIDER_INTERVALS_MS=openrouter=180000,groq=600000,nvidia=300000,gemini=300000,mistral=300000
# Se non specificato, usa HEALTH_CHECK_INTERVAL_MS per tutti i provider
HEALTH_CHECK_BATCH_SIZE=20
HEALTH_CHECK_TIMEOUT_MS=15000
HEALTH_CHECK_VERBOSE=false

# Webhook notifiche (Slack, Discord, o endpoint generico)
# URL multipli separati da virgola
WEBHOOK_URLS=
WEBHOOK_ENABLED=true
WEBHOOK_THROTTLE_MS=300000

# ─── Logging / debug noise control ───────────────────────────────────────────
# Dashboard stats logging throttling (default 60s)
# Throttles the "[DEBUG server] /v1/dashboard/stats serving stats:" line.
DASHBOARD_STATS_LOG_INTERVAL_MS=60000
# Throttles the "[API] GET /v1/models ..." line (default 60s)
MODELS_LOG_THROTTLE_MS=60000
# Log the CORS/debug line for every incoming request (default false = silent)
CORS_DEBUG=false
# Seed the verbose debug flag at startup (default false).
# The flag auto-expires after DEBUG_VERBOSE_TTL_MS.
DEBUG_VERBOSE=false
# TTL of the verbose debug flag in ms (default 900000 = 15 min)
DEBUG_VERBOSE_TTL_MS=900000
# Lines matching these tags are still written to the terminal but excluded from
# the /v1/logs ring buffer.  Pipe-separated list of tag names (no brackets).
# Default: CORS/DEBUG|DEBUG AUTH|DEBUG server|PROXY
# Leave empty to keep the built-in default list.
LOG_BUFFER_DENYLIST=

# Telegram (opzionale)
# 1. Crea un bot con @BotFather → ottieni il token
# 2. Manda un messaggio al bot
# 3. Visita https://api.telegram.org/bot<TOKEN>/getUpdates per il chat_id
# Esempio WEBHOOK_URLS: https://api.telegram.org/bot123456:ABC/sendMessage
TELEGRAM_CHAT_ID=
# Filtri modelli free/paid
# EXCLUDE_PAID=true  → esclude modelli marcati is_paid (dopo 402)
# ONLY_FREE=true     → considera SOLO modelli con :free/-free nel nome
EXCLUDE_PAID=false
ONLY_FREE=false
