{
  "fallbackModels": [
    "mistral/ministral-8b-latest",
    "groq/allam-2-7b",
    "mistral/mistral-small-latest",
    "mistral/mistral-large-latest",
    "groq/llama-3.3-70b-versatile",
    "openrouter/gpt-oss-20b",
    "nvidia/nemotron-mini",
    "gemini/gemini-1.5-flash",
    "cfp/claude-3-haiku",
    "dva/dva-small",
    "xai-oauth/grok-3-mini",
    "xao/grok-3-mini"
  ],
  "punishmentThresholds": {
    "consecutiveCriticalFailuresForBan": 7,
    "circuitBreakerThreshold": 5,
    "circuitBreakerCooldownMs": 120000,
    "maxTotalFailuresBeforePermanentBan": 15,
    "degradationThreshold": 5,
    "groupPunishment": {
      "enabled": true,
      "freeGroupThreshold": 7,
      "paidGroupThreshold": 5,
      "cooldownMultiplier": 2.0,
      "escalationStepMs": 86400000
    }
  },
  "errorConfig": {
    "degradationThreshold": 5,
    "rehabilitationPeriodMs": 172800000,
    "classification": {
      "transientErrors": [
        { "pattern": "timeout", "action": "cooldown-model", "duration": 600000 },
        { "pattern": "No auth provided|Please log in|Playwright is not available|Playwright.*Chromium|Cloudflare Playground needs Playwright|is not configured|missing url or token|browserType.launch|Executable doesn't exist", "action": "cooldown-model", "duration": 60000, "reason": "provider-misconfigured" },
        { "pattern": "ENOENT|spawn.*ENOENT|command not found|CLI not found|bridge sandbox|transport is not configured", "action": "cooldown-model", "duration": 60000, "reason": "provider-misconfigured" },
        { "pattern": "502|503|504", "action": "cooldown-model", "duration": 60000, "reason": "upstream-error" },
        { "pattern": "502.*timeout|503.*timeout|504 timeout|504 gateway timeout|gateway timeout", "action": "cooldown-model", "duration": 60000, "reason": "gateway-timeout" },
        { "pattern": "502.*high demand|502.*overloaded|502.*temporarily unavailable|503.*high demand|503.*overloaded|503.*temporarily unavailable", "action": "cooldown-model", "duration": 30000, "reason": "upstream-overloaded" },
        { "pattern": "5xx|server-error", "action": "cooldown-model", "duration": 30000, "reason": "upstream-error" },
        { "pattern": "rate.?limit|too.?many.?requests|throttled|quota.?exceeded|exhausted", "action": "cooldown-model", "duration": 300000 },
        { "pattern": "429|cooling down", "action": "cooldown-model", "duration": 300000 },
        { "pattern": "RATE_LIMIT_QUEUE_TIMEOUT|503 queue timeout|queue timeout", "action": "cooldown-model", "duration": 45000 },
        { "pattern": "high demand|service.unavailable|service unavailable", "action": "cooldown-model", "duration": 30000 },
        { "pattern": "413|ITPM|tokens.?per.?minute|TPM|Request too large|context.?(?:window|length|exceeded)|token.?limit|payload.?too.?large", "action": "cooldown-model", "duration": 300000, "reason": "tpm-exceeded" },
        { "pattern": "403.*lifetime limit|403.*never resets|403.*total limit|403.*does not reset|403.*no reset|lifetime limit|never resets|total limit|does not reset|no reset", "action": "cooldown-model", "duration": 300000, "reason": "key-limit-exceeded", "status": 403 },
        { "pattern": "403.*access denied|403.*permission denied|403.*forbidden|403.*insufficient permissions|403.*not authorized", "action": "cooldown-model", "duration": 60000, "reason": "access-denied", "status": 403 },
        { "pattern": "401|authentication expired|No active credentials", "action": "flag-provider", "duration": 86400000, "reason": "auth-expired" },
        { "pattern": "402|insufficient.?funds|credit.?exhausted|payment.?required|billing_error", "action": "flag-provider", "duration": 86400000 },
        { "pattern": "418|anti.abuse", "action": "cooldown-provider", "duration": 3600000 },
        { "pattern": "safeWrite|cannot access safeWrite|safeWrite before initialization|safeWrite is not initialized", "action": "cooldown-model", "duration": 300000, "reason": "safeWrite-init-error" },
        { "pattern": "400.*validation|400.*bad request|400.*invalid request|400.*parameter|400.*request.*invalid|400.*missing.*field|400.*invalid.*input", "action": "cooldown-model", "duration": 30000, "reason": "transient-400-error" },
        { "pattern": "^404$", "action": "cooldown-model", "duration": 30000, "reason": "transient-404", "status": 404 },
        { "pattern": "SSE contains error|SSE chunk error|stream error|keepalive|connection|chunk", "action": "cooldown-model", "duration": 30000, "reason": "stream-error" },
        { "pattern": "unknown model|model_?not.?found|model not found|invalid model|does not exist|no longer available|not available in active live catalog", "action": "cooldown-model", "duration": 300000, "reason": "model-not-found" }
      ],
      "permanentErrors": [
        { "pattern": "account.?(?:disabled|suspended|banned|terminated|closed|deactivated)|organization.?(?:disabled|suspended|banned|deleted|deactivated)|project.?(?:deleted|disabled|suspended)|workspace.?(?:disabled|suspended|deleted)|policy.?violation|provider.?banned|banned|suspended", "action": "ban-provider", "scope": "provider" },
        { "pattern": "account disabled|banned", "action": "ban-provider", "scope": "provider" },
        { "pattern": "no.tool.call.but.required", "action": "ban-model", "scope": "model" },
        { "pattern": "image generation model|cannot be used for chat|not a chat model|image.only|incompatible", "action": "ban-model", "scope": "model" },
        { "pattern": "unsupported_image_block", "action": "ban-model", "scope": "model" },
        { "pattern": "devin_agentic_error|Historical tool_use references undeclared tool", "action": "cooldown-model", "scope": "model", "duration": 60000, "reason": "tool-capability-error" },
        { "pattern": "not supported.*(?:image.?block|vision|visual.?input|picture.?format|base64.?image|image.?unsupported)", "action": "ban-model", "scope": "model" },
        { "pattern": "Assignment to constant variable", "action": "ban-model", "scope": "model" },
        { "pattern": "OpenCode's free tier can only be used from within OpenCode", "action": "ban-model", "scope": "model" },
        { "pattern": "catalog.?mismatch|active live catalog.*empty|no.*models? available", "action": "ban-model", "scope": "model", "reason": "model-not-found" }
      ]
    }
  }
}
